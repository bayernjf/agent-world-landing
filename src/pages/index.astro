---
import Layout from "../layouts/Layout.astro";
import Hud from "../components/Hud.astro";
import Hero from "../components/Hero.astro";
import ControlPanel from "../components/ControlPanel.astro";
import Pipeline from "../components/Pipeline.astro";
import Sandbox from "../components/Sandbox.astro";
import SkillCards from "../components/SkillCards.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Hud />
  <main>
    <Hero />
    <div data-reveal><ControlPanel /></div>
    <div data-reveal><Pipeline /></div>
    <div data-reveal><Sandbox /></div>
    <div data-reveal><SkillCards /></div>
    <div data-reveal><Cta /></div>
  </main>
  <Footer />
</Layout>
