---
import "../styles/global.css";
import {
  getLangFromUrl,
  useTranslations,
  getAltLangPath,
  getOtherLang,
} from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t("meta.title");
const description = t("meta.description");

const altPath = getAltLangPath(Astro.url, lang);
const altLang = getOtherLang(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(altPath, Astro.site);
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06090b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={lang === "zh" ? "zh-CN" : "en"} href={canonical.href} />
    <link rel="alternate" hreflang={altLang === "zh" ? "zh-CN" : "en"} href={altUrl.href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <div class="crt" aria-hidden="true"></div>

    <script>
      // reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      // live HUD readouts — the console should feel alive
      const clock = document.getElementById("res-clock");
      const tokens = document.getElementById("res-tokens");
      let t = 24192;

      setInterval(() => {
        if (clock) {
          const d = new Date();
          clock.textContent = [d.getHours(), d.getMinutes(), d.getSeconds()]
            .map((n) => String(n).padStart(2, "0"))
            .join(":");
        }
        if (tokens) {
          t += Math.floor(Math.random() * 90) - 30;
          // A machine readout, so the grouping stays fixed rather than
          // following the page locale.
          tokens.textContent = t.toLocaleString("en-US");
        }
      }, 1000);
    </script>
  </body>
</html>
