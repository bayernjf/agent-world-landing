---
// ControlPanel — RTS‑style command dashboard with live gauges
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id="control" class="shell">
  <span class="stencil">{t("control.stencil")}</span>
  <h2 class="h-sec">{t("control.title")}</h2>
  <p class="sub-sec">{t("control.sub")}</p>

  <div class="dash">
    <!-- primary row: 3 large gauges -->
    <div class="panel panel--riveted dash__primary">
      <div class="panel__bar">
        <span>{t("control.resources")}</span>
        <span class="led" data-c="power" />
      </div>
      <div class="dash__primary-inner">
        <div class="dash__metric">
          <span class="dash__metric-label">{t("control.tokenSupply")}</span>
          <div class="dash__value">
            <span class="readout dash__num">24,192</span>
            <span class="dash__unit">tokens</span>
          </div>
          <div class="gauge"><i style="width:74%"></i></div>
          <div class="dash__sub">
            <span>{t("control.capacity")}</span>
            <span>{t("control.load")}</span>
          </div>
        </div>
        <div class="dash__metric">
          <span class="dash__metric-label">{t("control.agentActivity")}</span>
          <div class="dash__value">
            <span class="readout dash__num">12</span>
            <span class="dash__unit">{t("control.online")}</span>
          </div>
          <div class="gauge"><i style="width:75%"></i></div>
          <div class="dash__sub">
            <span>{t("control.idleWorking")}</span>
            <span>{t("control.standby")}</span>
          </div>
        </div>
        <div class="dash__metric">
          <span class="dash__metric-label">{t("control.throughput")}</span>
          <div class="dash__value">
            <span class="readout dash__num">41</span>
            <span class="dash__unit">arts / min</span>
          </div>
          <div class="gauge"><i style="width:62%"></i></div>
          <div class="dash__sub">
            <span>{t("control.peak")}</span>
            <span>{t("control.utilization")}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- secondary row: 4 smaller panels -->
    <div class="dash__secondary">
      <div class="panel panel--riveted dash__stat-panel">
        <div class="panel__bar">
          <span>{t("control.queue")}</span>
          <span class="led" data-c="data" />
        </div>
        <div class="dash__stat-inner">
          <div class="readout dash__num-s">7</div>
          <div class="dash__queue">
            <span class="dash__q-item">{t("control.queued")}</span>
            <span class="dash__q-item">{t("control.processing")}</span>
            <span class="dash__q-item">{t("control.review")}</span>
          </div>
          <div class="dash__q-bars">
            <div class="dash__q-bar"><i style="width:60%"></i></div>
            <div class="dash__q-bar"><i style="width:85%"></i></div>
            <div class="dash__q-bar"><i style="width:40%"></i></div>
          </div>
        </div>
      </div>
      <div class="panel panel--riveted dash__stat-panel">
        <div class="panel__bar">
          <span>{t("control.quality")}</span>
          <span class="led" data-c="ok" />
        </div>
        <div class="dash__stat-inner">
          <div class="readout dash__num-s" style="color:var(--ok)">96.3%</div>
          <div class="dash__sub" style="margin-top:6px;text-align:center">
            <span>{t("control.passRate")}</span>
            <span>{t("control.reworkRate")}</span>
          </div>
        </div>
      </div>
      <div class="panel panel--riveted dash__stat-panel">
        <div class="panel__bar">
          <span>{t("control.power")}</span>
          <span class="led" data-c="power" />
        </div>
        <div class="dash__stat-inner">
          <div class="readout dash__num-s" style="color:var(--power)">23.7k</div>
          <div class="dash__sub" style="margin-top:6px;text-align:center">
            <span>{t("control.current")}</span>
            <span>{t("control.budget")}</span>
          </div>
        </div>
      </div>
      <div class="panel panel--riveted dash__stat-panel">
        <div class="panel__bar">
          <span>{t("control.system")}</span>
          <span class="led" data-c="data" />
        </div>
        <div class="dash__stat-inner">
          <div class="dash__status-list">
            <div class="dash__status-row">
              <span class="led" data-c="ok" />
              <span>{t("control.orchestrator")}</span>
            </div>
            <div class="dash__status-row">
              <span class="led" data-c="ok" />
              <span>{t("control.pipes")}</span>
            </div>
            <div class="dash__status-row">
              <span class="led" data-c="ok" />
              <span>{t("control.storage")}</span>
            </div>
            <div class="dash__status-row">
              <span class="led" data-c="ok" />
              <span>{t("control.api")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dash {
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .dash__primary {
    overflow: hidden;
  }
  .dash__primary-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 24px 28px;
  }
  .dash__metric {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dash__metric-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .dash__value {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .dash__num {
    font-size: 32px;
    color: var(--ink);
  }
  .dash__num-s {
    font-size: 28px;
    color: var(--data);
  }
  .dash__unit {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-faint);
  }
  .dash__sub {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-faint);
  }

  .dash__secondary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .dash__stat-panel {
    overflow: hidden;
  }
  .dash__stat-inner {
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .dash__queue {
    display: flex;
    gap: 12px;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-faint);
  }
  .dash__q-bars {
    margin-top: 8px;
    width: 100%;
    display: flex;
    gap: 12px;
  }
  .dash__q-bar {
    flex: 1;
    height: 5px;
    background: var(--steel-900);
    border: 1px solid var(--steel-600);
    overflow: hidden;
  }
  .dash__q-bar i {
    display: block;
    height: 100%;
    background: var(--data);
  }

  .dash__status-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }
  .dash__status-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
  }

  @media (max-width: 800px) {
    .dash__primary-inner {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 18px;
    }
    .dash__secondary {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 500px) {
    .dash__secondary {
      grid-template-columns: 1fr;
    }
  }
</style>