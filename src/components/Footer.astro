---
import BayjfLink from "@bay/landing-ui/components/BayjfLink.astro";
import StarOnGithub from "@bay/landing-ui/components/StarOnGithub.astro";
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations, getAltLangPath, localizePath } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altPath = getAltLangPath(Astro.url, lang);

// the legal pages carry this footer too, so section links have to be absolute
const home = localizePath("/", lang);

const year = 2026;
---

<footer class="foot">
  <div class="shell foot__inner">
    <div class="foot__brand">
      <span class="foot__mark-row">
        <Logo />
        <span class="foot__logo">AGENT&thinsp;WORLD</span>
      </span>
      <p class="foot__tag">{t("foot.tag")}</p>
    </div>
    <nav class="foot__nav">
      <a href={`${home}#control`}>{t("foot.nav.control")}</a>
      <a href={`${home}#pipeline`}>{t("foot.nav.pipeline")}</a>
      <a href={`${home}#sandbox`}>{t("foot.nav.sandbox")}</a>
      <a href={`${home}#skills`}>{t("foot.nav.skills")}</a>
      <a href={`${home}#cta`}>{t("foot.nav.cta")}</a>
      <a href={localizePath("/privacy", lang)}>{t("foot.nav.privacy")}</a>
      <a href={localizePath("/terms", lang)}>{t("foot.nav.terms")}</a>
    </nav>
    <div class="foot__ext">
      <BayjfLink size={16} />
      <StarOnGithub href="https://github.com/bayernjf/agent-world" size={14} />
      <a class="lang-switch" href={altPath} hreflang={lang === "zh" ? "en" : "zh-CN"}>
        {t("nav.langSwitch")}
      </a>
    </div>
    <div class="foot__meta">
      <span class="readout">v0.1.0-alpha</span>
      <span>© {year} Agent World</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding: 34px 0 40px;
    border-top: 1px solid var(--steel-700);
    background: var(--steel-900);
  }
  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .foot__mark-row {
    display: flex;
    align-items: center;
    gap: 9px;
    --logo-size: 24px;
  }
  .foot__logo {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.26em;
    color: var(--ink-dim);
  }
  .foot__tag {
    margin-top: 6px;
    font-size: 12px;
    color: var(--ink-faint);
  }
  .foot__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }
  .foot__nav a:hover {
    color: var(--data);
  }
  .foot__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-faint);
  }
  .foot__ext {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-faint);
  }
  /* :global, because these anchors come from @bay/landing-ui and so carry that
     component's scope attribute rather than this one's */
  .foot__ext :global(a) {
    transition: color 160ms ease-out;
  }
  .foot__ext :global(a:hover) {
    color: var(--data);
  }

  @media (max-width: 700px) {
    .foot__meta { align-items: flex-start; }
  }
</style>