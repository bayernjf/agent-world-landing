---
// RTS‑style HUD bar: resources, time, minimap hint
import BayjfLink from "@bay/landing-ui/components/BayjfLink.astro";
import StarOnGithub from "@bay/landing-ui/components/StarOnGithub.astro";
import Logo from "./Logo.astro";
---

<header class="hud">
  <div class="hud__inner shell">
    <!-- left: brand -->
    <a class="hud__brand" href="#top" aria-label="Agent World 首页">
      <Logo />
      <span class="hud__logo">AGENT&thinsp;WORLD</span>
      <span class="led" data-c="power" aria-hidden="true"></span>
    </a>

    <!-- center: resources -->
    <div class="hud__group">
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--power)" stroke-width="1.8"><path d="M12 2v10l4 3-4 7m-4-7 4 3"/><path d="M12 12 8 9l4-3 4 3z"/></svg>
        <span class="readout" id="res-tokens">24,192</span>
        <span class="hud__label">TOKENS</span>
      </div>
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--data)" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span class="readout" id="res-agents">12</span>
        <span class="hud__label">AGENTS</span>
      </div>
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="1.8"><path d="M22 12A10 10 0 1 1 12 2v10l5 3"/></svg>
        <span class="readout" id="res-uptime">99.7%</span>
        <span class="hud__label">UPTIME</span>
      </div>
    </div>

    <!-- right: clock + status -->
    <div class="hud__group hud__group--right">
      <div class="hud__stat">
        <span class="led" data-c="data" aria-hidden="true"></span>
        <span class="readout">SYSTEM NOMINAL</span>
      </div>
      <div class="hud__stat">
        <span class="readout" id="res-clock">14:28:07</span>
      </div>
      <div class="hud__ext">
        <BayjfLink size={17} />
        <StarOnGithub href="https://github.com/bayernjf/agent-world" size={15} />
      </div>
    </div>
  </div>
  <!-- bottom border glow -->
  <div class="hud__glow" aria-hidden="true"></div>
</header>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(180deg, var(--steel-900) 0%, var(--steel-850) 100%);
    border-bottom: 1px solid var(--steel-600);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
  }
  .hud__glow {
    height: 1px;
    background: linear-gradient(90deg, transparent 10%, var(--power) 40%, var(--data) 60%, transparent 90%);
    opacity: 0.18;
  }
  .hud__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    gap: 16px;
  }
  .hud__group {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .hud__group--right {
    gap: 20px;
  }
  .hud__res {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .hud__res .readout {
    font-size: 15px;
    color: var(--ink);
  }
  .hud__label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    align-self: flex-end;
    margin-bottom: 1px;
  }
  .hud__brand {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
    --logo-size: 22px;
  }
  .hud__logo {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.28em;
    background: linear-gradient(90deg, var(--power), var(--data));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hud__stat {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
  }
  .hud__stat .readout {
    font-size: 11px;
  }
  .hud__ext {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 18px;
    border-left: 1px solid var(--steel-600);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }
  /* :global, because these anchors come from @bay/landing-ui and so carry that
     component's scope attribute rather than this one's */
  .hud__ext :global(a) {
    transition: color 160ms ease-out;
  }
  .hud__ext :global(a:hover) {
    color: var(--data);
  }

  @media (max-width: 1100px) {
    /* the decorative status readout yields first, so the brand links survive longer */
    .hud__group--right .hud__stat:first-child { display: none; }
  }

  @media (max-width: 1000px) {
    /* icons still identify the readouts, so the word labels can go next */
    .hud__res .hud__label { display: none; }
    .hud__group { gap: 16px; }
  }

  @media (max-width: 900px) {
    /* out of room in the bar; the footer still carries both links */
    .hud__ext { display: none; }
  }

  @media (max-width: 720px) {
    .hud__inner { height: 44px; }
    .hud__logo { font-size: 12px; letter-spacing: 0.2em; }
    .hud__brand { gap: 7px; --logo-size: 19px; }
    /* the brand now owns the left slot, so the bar can only carry one readout */
    .hud__res:not(:first-child) { display: none; }
  }
</style>