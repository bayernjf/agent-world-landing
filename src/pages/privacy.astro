---
import Layout from "../layouts/Layout.astro";
import Hud from "../components/Hud.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, SOCIAL } from "../consts";

const title = `Privacy Policy | ${SITE_NAME}`;
const description = `Privacy Policy of ${SITE_NAME}: how information related to your visit is handled.`;
---

<Layout title={title} description={description}>
  <Hud />
  <main class="doc">
    <div class="shell">
      <article class="panel panel--riveted doc__panel">
        <p class="stencil">privacy policy</p>
        <h1>Privacy Policy</h1>
        <p class="doc__stamp">Last updated: August 25, 2026</p>

        <div class="doc__body">
          <section>
            <h2>1. Overview</h2>
            <p>
              {SITE_NAME} (the "Site") is a product introduction website. We respect and
              protect the privacy of our visitors. This policy explains how information
              related to your visit is handled. By using the Site you agree to the terms of
              this policy.
            </p>
          </section>

          <section>
            <h2>2. Information We Handle</h2>
            <ul>
              <li>
                The Site is static and offers no account registration. Apart from the beta
                access form, it does not collect personally identifiable information.
              </li>
              <li>
                If you submit the beta access form, we keep the email address and team size
                you provide, and use them only to send build permits and beta notices.
              </li>
              <li>
                The hosting platform (Cloudflare Pages) may record basic access logs (IP,
                User-Agent, etc.) under its own policies, outside our control.
              </li>
              <li>
                If analytics are enabled in the future, only anonymized usage statistics
                (page views, referrers, etc.) will be used, never to identify individuals.
              </li>
            </ul>
          </section>

          <section>
            <h2>3. The Interactive Sandbox</h2>
            <p>
              The sandbox on this Site runs entirely in your browser. The plants you drag,
              the pipes you lay and the dispatches you trigger are never sent to a server,
              and nothing about them is stored or transmitted.
            </p>
          </section>

          <section>
            <h2>4. Cookies &amp; Local Storage</h2>
            <p>
              The Site may use browser cookies or localStorage to remember interface
              preferences such as language. These are used solely to improve browsing and
              never for cross-site tracking. You can disable or clear them in your browser
              settings.
            </p>
          </section>

          <section>
            <h2>5. Third-Party Links</h2>
            <p>
              The Site contains links to third-party websites such as GitHub. Their privacy
              practices are not covered by this policy; please refer to their own policies.
            </p>
          </section>

          <section>
            <h2>6. Children</h2>
            <p>
              The Site is not directed at children under 14, and we do not knowingly collect
              personal information from them.
            </p>
          </section>

          <section>
            <h2>7. Changes</h2>
            <p>
              This policy may be updated as the product evolves. Changes will be posted on
              this page with an updated revision date.
            </p>
          </section>

          <section>
            <h2>8. Contact</h2>
            <p>
              Questions about this policy can be raised via Issues on our
              <a href={SOCIAL.github}>GitHub repository</a>, or by email at
              <a href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</a>.
            </p>
          </section>
        </div>

        <a class="btn btn--ghost doc__back" href="/">Back to base</a>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
