---
// SkillCards — Age of Empires style tech tree: 6 branches x 4 tiers = 24 skill cards.
// Same-branch prerequisites are drawn as connector lines; cross-branch ones render as tags.
// Names, descriptions and effects live in the copy dictionary, keyed by skill id.
import { getLangFromUrl, useTranslations, fmt, type UIKey } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));

interface Skill {
  /** stable key: the tech graph and the copy dictionary both hang off this */
  id: string;
  icon: string;
  cost: string;
  prereq: string[];
  active: boolean;
}

interface Branch {
  key: string;
  code: string;
  accent: string;
  /** exactly four, one per tier T1..T4 */
  skills: Skill[];
}

const branches: Branch[] = [
  {
    key: "orchestration",
    code: "ORCHESTRATION",
    accent: "var(--plasma)",
    skills: [
      {
        id: "orch.decompose",
        icon: "M",
        cost: "1,200",
        prereq: [],
        active: true,
      },
      {
        id: "orch.parallel",
        icon: "II",
        cost: "4,800",
        prereq: ["orch.decompose"],
        active: true,
      },
      {
        id: "orch.schedule",
        icon: "⇄",
        cost: "14,000",
        prereq: ["orch.parallel", "infra.pipeline"],
        active: true,
      },
      {
        id: "orch.route",
        icon: "◎",
        cost: "42,000",
        prereq: ["orch.schedule", "intel.consensus"],
        active: false,
      },
    ],
  },
  {
    key: "fabrication",
    code: "FABRICATION",
    accent: "var(--power)",
    skills: [
      {
        id: "fab.template",
        icon: "□",
        cost: "900",
        prereq: [],
        active: true,
      },
      {
        id: "fab.incremental",
        icon: "⊞",
        cost: "5,200",
        prereq: ["fab.template"],
        active: true,
      },
      {
        id: "fab.multimodel",
        icon: "△",
        cost: "18,000",
        prereq: ["fab.incremental", "intel.distill"],
        active: false,
      },
      {
        id: "fab.overclock",
        icon: "◆",
        cost: "56,000",
        prereq: ["fab.multimodel", "infra.battery"],
        active: false,
      },
    ],
  },
  {
    key: "quality",
    code: "QUALITY",
    accent: "var(--ok)",
    skills: [
      {
        id: "qa.lint",
        icon: "Q",
        cost: "3,200",
        prereq: [],
        active: true,
      },
      {
        id: "qa.regression",
        icon: "⊙",
        cost: "6,400",
        prereq: ["qa.lint"],
        active: true,
      },
      {
        id: "qa.rework",
        icon: "↻",
        cost: "16,000",
        prereq: ["qa.regression"],
        active: true,
      },
      {
        id: "qa.formal",
        icon: "⊗",
        cost: "72,000",
        prereq: ["qa.rework", "intel.index"],
        active: false,
      },
    ],
  },
  {
    key: "intel",
    code: "INTELLIGENCE",
    accent: "var(--data)",
    skills: [
      {
        id: "intel.explore",
        icon: "○",
        cost: "1,600",
        prereq: [],
        active: true,
      },
      {
        id: "intel.distill",
        icon: "◈",
        cost: "7,800",
        prereq: ["intel.explore"],
        active: true,
      },
      {
        id: "intel.index",
        icon: "≡",
        cost: "21,000",
        prereq: ["intel.distill"],
        active: false,
      },
      {
        id: "intel.consensus",
        icon: "✦",
        cost: "64,000",
        prereq: ["intel.index", "qa.regression"],
        active: false,
      },
    ],
  },
  {
    key: "infra",
    code: "INFRASTRUCTURE",
    accent: "var(--warn)",
    skills: [
      {
        id: "infra.grid",
        icon: "≋",
        cost: "1,000",
        prereq: [],
        active: true,
      },
      {
        id: "infra.pipeline",
        icon: "⊥",
        cost: "8,000",
        prereq: ["infra.grid"],
        active: true,
      },
      {
        id: "infra.battery",
        icon: "▲",
        cost: "19,000",
        prereq: ["infra.pipeline"],
        active: false,
      },
      {
        id: "infra.selfheal",
        icon: "✧",
        cost: "88,000",
        prereq: ["infra.battery", "ship.multi"],
        active: false,
      },
    ],
  },
  {
    key: "delivery",
    code: "DELIVERY",
    accent: "color-mix(in srgb, var(--data) 55%, var(--plasma))",
    skills: [
      {
        id: "ship.depot",
        icon: "⇩",
        cost: "1,400",
        prereq: [],
        active: true,
      },
      {
        id: "ship.canary",
        icon: "⊕",
        cost: "6,800",
        prereq: ["ship.depot"],
        active: false,
      },
      {
        id: "ship.fleet",
        icon: "⇉",
        cost: "17,500",
        prereq: ["ship.canary"],
        active: false,
      },
      {
        id: "ship.multi",
        icon: "★",
        cost: "60,000",
        prereq: ["ship.fleet", "qa.rework"],
        active: false,
      },
    ],
  },
];

const tiers = ["T1", "T2", "T3", "T4"] as const;

const unlocked = branches.reduce(
  (n, b) => n + b.skills.filter((s) => s.active).length,
  0
);
const total = branches.reduce((n, b) => n + b.skills.length, 0);

// Cross-branch prerequisites are referenced by id, so the tag needs a way back
// to the display name.
const nameById = new Map(
  branches.flatMap((b) =>
    b.skills.map((s) => [s.id, t(`skills.${s.id}.name` as UIKey)] as const)
  )
);
---

<section id="skills" class="shell">
  <span class="stencil">{t("skills.stencil")}</span>
  <h2 class="h-sec">{t("skills.title")}</h2>
  <p class="sub-sec">{fmt(t("skills.sub"), { total })}</p>

  <div class="tree-meta">
    <span class="tree-meta__count readout">{unlocked} / {total}</span>
    <span class="tree-meta__label">{t("skills.unlocked")}</span>
    <div class="gauge tree-meta__gauge">
      <i style={`width:${(unlocked / total) * 100}%`}></i>
    </div>
    <span class="tree-meta__pan">{t("skills.pan")}</span>
  </div>

  <div class="tree-scroll">
    <div class="tree">
      <div class="tree__tiers">
        {
          tiers.map((tier) => (
            <div class="tree__tier">
              <span class="tree__tier-id">{tier}</span>
              <span class="tree__tier-label">{t(`skills.tier.${tier}` as UIKey)}</span>
            </div>
          ))
        }
      </div>

      {
        branches.map((b) => (
          <div class="tree__branch" style={`--accent:${b.accent}`}>
            <div class="tree__head">
              <span class="tree__head-label">{t(`skills.branch.${b.key}.label` as UIKey)}</span>
              <span class="tree__head-code">{b.code}</span>
              <span class="tree__head-blurb">{t(`skills.branch.${b.key}.blurb` as UIKey)}</span>
            </div>

            <div class="tree__row">
              {b.skills.map((s, i) => {
                const own = b.skills.map((x) => x.id);
                const crossed = s.prereq.filter((p) => !own.includes(p));
                return (
                  <div
                    class:list={["tech", { "tech--locked": !s.active }]}
                    data-tier={tiers[i]}
                  >
                    {i > 0 && <span class="tech__link" aria-hidden="true"></span>}
                    <div class="tech__top">
                      <span class="tech__icon" aria-hidden="true">{s.icon}</span>
                      <span class="tech__tier">{tiers[i]}</span>
                    </div>
                    <h3 class="tech__name">{t(`skills.${s.id}.name` as UIKey)}</h3>
                    <p class="tech__desc">{t(`skills.${s.id}.desc` as UIKey)}</p>
                    {crossed.length > 0 && (
                      <div class="tech__prereq">
                        <span class="tech__prereq-hint">{t("skills.prereqHint")}</span>
                        {crossed.map((p) => (
                          <span class="tech__prereq-tag">{nameById.get(p)}</span>
                        ))}
                      </div>
                    )}
                    <div class="tech__foot">
                      <span class="tech__cost">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--power)" stroke-width="2"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg>
                        {s.cost}
                      </span>
                      <span class="tech__effect">{t(`skills.${s.id}.effect` as UIKey)}</span>
                    </div>
                    {!s.active && <span class="tech__lock" title={t("skills.lockedTitle")}>LOCKED</span>}
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ---------- progress meta ---------- */
  .tree-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
    font-family: var(--mono);
  }
  .tree-meta__count {
    font-size: 18px;
    color: var(--power);
  }
  .tree-meta__label {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .tree-meta__gauge {
    width: 160px;
  }
  .tree-meta__pan {
    display: none;
    margin-left: auto;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
  }

  /* ---------- tree frame ---------- */
  .tree-scroll {
    margin-top: 22px;
  }

  .tree {
    --gap: 16px;
    --card: minmax(210px, 1fr);
  }

  .tree__tiers,
  .tree__row {
    display: grid;
    grid-template-columns: repeat(4, var(--card));
    gap: var(--gap);
  }

  .tree__tiers {
    padding-bottom: 9px;
    border-bottom: var(--hair);
  }

  .tree__tier {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--mono);
  }
  .tree__tier-id {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }
  .tree__tier-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
  }

  /* ---------- branch ---------- */
  .tree__branch {
    padding: 22px 0 24px;
    border-bottom: var(--hair);
  }
  .tree__branch:last-child {
    border-bottom: 0;
  }

  .tree__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
    padding-left: 11px;
    border-left: 3px solid var(--accent);
  }
  .tree__head-label {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .tree__head-code {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--accent);
  }
  .tree__head-blurb {
    font-size: 12px;
    color: var(--ink-faint);
  }

  /* ---------- card ---------- */
  .tech {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 14px 15px 13px;
    background: linear-gradient(180deg, var(--steel-800), var(--steel-850));
    border: 1px solid var(--steel-600);
    border-top: 2px solid var(--accent);
    box-shadow: var(--bevel);
    transition: border-color 0.25s, transform 0.2s, box-shadow 0.25s;
  }
  .tech:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--steel-500));
    box-shadow: var(--bevel), 0 0 26px -12px var(--accent);
  }

  /* prerequisite connector, drawn into the grid gap on the card's left */
  .tech__link {
    position: absolute;
    top: 50%;
    left: calc(var(--gap) * -1 - 1px);
    width: calc(var(--gap) + 1px);
    height: 2px;
    background: var(--accent);
    opacity: 0.5;
  }
  .tech__link::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-50%);
    box-shadow: 0 0 8px var(--accent);
  }

  .tech--locked {
    opacity: 0.5;
    filter: saturate(0.35);
  }
  .tech--locked .tech__link {
    opacity: 0.28;
    background: repeating-linear-gradient(
      90deg,
      var(--accent) 0 4px,
      transparent 4px 8px
    );
  }
  .tech--locked .tech__link::after {
    display: none;
  }

  .tech__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .tech__icon {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .tech__tier {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .tech__name {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .tech__desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-dim);
  }

  .tech__prereq {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  .tech__prereq-hint {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }
  .tech__prereq-tag {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    padding: 2px 5px;
    color: var(--ink-dim);
    background: var(--steel-900);
    border: 1px solid var(--steel-600);
    border-left: 2px solid var(--accent);
  }

  .tech__foot {
    margin-top: auto;
    padding-top: 9px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-top: var(--hair);
  }

  .tech__cost {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--power);
  }

  .tech__effect {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    text-align: right;
    color: var(--ok);
  }

  /* small corner badge — a full-card overlay would drown a 24-card grid */
  .tech__lock {
    position: absolute;
    top: 0;
    right: 0;
    padding: 2px 6px;
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--steel-950);
    background: var(--steel-400);
  }
  .tech--locked .tech__tier {
    visibility: hidden;
  }

  /* ---------- narrow: pin and pan, same as the factory map ---------- */
  @media (max-width: 1000px) {
    .tree-scroll {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 10px;
    }
    .tree {
      min-width: 940px;
    }
    .tree-meta__pan {
      display: inline;
    }
  }

  @media (max-width: 620px) {
    .tree-meta {
      flex-wrap: wrap;
    }
    .tree-meta__gauge {
      width: 100%;
      order: 3;
    }
    .tree-meta__pan {
      order: 4;
      margin-left: 0;
    }
  }
</style>
