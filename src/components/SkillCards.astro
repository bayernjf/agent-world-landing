---
// SkillCards — Age of Empires style tech tree: 6 branches x 4 tiers = 24 skill cards.
// Same-branch prerequisites are drawn as connector lines; cross-branch ones render as tags.
interface Skill {
  name: string;
  desc: string;
  icon: string;
  cost: string;
  prereq: string[];
  effect: string;
  active: boolean;
}

interface Branch {
  key: string;
  label: string;
  code: string;
  accent: string;
  blurb: string;
  /** exactly four, one per tier T1..T4 */
  skills: Skill[];
}

